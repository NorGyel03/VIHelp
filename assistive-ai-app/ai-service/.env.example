# ─── Camera Mode ──────────────────────────────────────────────────
# "serial" = ESP32 plugged into PC via USB (for development)
# "wifi"   = ESP32 streaming over Wi-Fi    (for production)
CAMERA_MODE=serial

# ─── Serial Mode Settings ────────────────────────────────────────
# The COM port shown in Device Manager when ESP32 is plugged in
SERIAL_PORT=COM6
SERIAL_BAUD=921600

# ─── Wi-Fi Mode Settings ────────────────────────────────────────
# Only used when CAMERA_MODE=wifi
# The IP is printed in ESP32 Serial Monitor after boot
ESP32_STREAM_URL=http://192.168.1.100:81/stream

# ─── AI Models ───────────────────────────────────────────────────
# Path to YOLOv8 weights (copy best.pt from vihelp_website/weights/)
WEIGHTS_PATH=./weights/best.pt

# ─── Server ──────────────────────────────────────────────────────
AI_SERVICE_PORT=5000

# ─── Voice Feedback ──────────────────────────────────────────────
# Set to false to disable text-to-speech announcements
TTS_ENABLED=true

# ─── Node.js Backend (optional, for auto-posting detections) ─────
BACKEND_URL=http://localhost:3000
AUTH_TOKEN=
DEVICE_ID=
